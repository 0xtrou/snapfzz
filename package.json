{
  "name": "snapfzz-startup-launcher",
  "private": true,
  "scripts": {
    "dev:launcher": "pnpm --filter @snapfzz/launcher dev",
    "dev:project": "pnpm --filter @snapfzz/project dev",
    "dev:preferences": "pnpm --filter @snapfzz/preferences dev",
    "build:preferences": "pnpm --filter @snapfzz/preferences build",
    "build": "pnpm -r build",
    "build:launcher": "pnpm --filter @snapfzz/launcher build",
    "build:project": "pnpm --filter @snapfzz/project build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@chenglou/pretext": "^0.0.4",
    "@tauri-apps/api": "^2.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  }
}
