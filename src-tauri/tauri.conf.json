{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/core/tauri/schema.json",
  "productName": "Snapfzz",
  "identifier": "com.snapfzz.snapfzz",
  "version": "0.0.1",
  "build": {
    "frontendDist": "../frontend/dist/launcher",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev:project & pnpm dev:preferences",
    "beforeBuildCommand": "pnpm build:project"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Snapfzz",
        "label": "launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "title": "Snapfzz Preferences",
        "label": "preferences",
        "url": "http://localhost:5175",
        "width": 720,
        "height": 560,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
