{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/core/tauri/schema.json",
  "productName": "Snapfzz",
  "identifier": "com.snapfzz.snapfzz",
  "version": "0.0.1",
  "build": {
    "frontendDist": "../frontend/dist/launcher",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm --filter @snapfzz/orchestrator-plugin build && pnpm dev:project & pnpm dev:preferences",
    "beforeBuildCommand": "pnpm --filter @snapfzz/orchestrator-plugin build && pnpm build:project"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Snapfzz",
        "label": "launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "title": "Settings",
        "label": "preferences",
        "url": "http://localhost:5175",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.snapfzz/plugins/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": {
      "../plugins/orchestrator/dist": "plugins/snapfzz.orchestrator/dist",
      "../plugins/orchestrator/intelligence": "plugins/snapfzz.orchestrator/intelligence",
      "../plugins/orchestrator/manifest.json": "plugins/snapfzz.orchestrator/manifest.json"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
